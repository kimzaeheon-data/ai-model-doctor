{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-model-doctor.local/schemas/change-plan.schema.json",
  "title": "AI Model Doctor Change Plan",
  "description": "승인 전에 검토하는 불변 모델 설정 변경 계획",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "status",
    "source",
    "summary",
    "changes",
    "limitations",
    "approval_required",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "plan_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{8,64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"const": "awaiting_approval"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_schema_version", "diagnosis_schema_version", "run_name"],
      "properties": {
        "evaluation_schema_version": {"const": "0.1.0"},
        "diagnosis_schema_version": {"const": "0.1.0"},
        "run_name": {"type": ["string", "null"]}
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/change"}
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "approval_required": {"const": true},
    "execution_allowed": {"const": false}
  },
  "$defs": {
    "value": {
      "type": ["number", "integer", "string", "boolean", "null"]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "category",
        "parameter",
        "target_file",
        "before",
        "after",
        "human_readable_diff",
        "rationale",
        "referenced_diagnoses",
        "expected_effects",
        "risks",
        "estimated_cost"
      ],
      "properties": {
        "change_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{3,64}$"},
        "category": {"enum": ["training", "inference"]},
        "parameter": {"type": "string", "minLength": 1},
        "target_file": {"enum": ["candidate/args.yaml", "candidate/inference.yaml"]},
        "before": {"$ref": "#/$defs/value"},
        "after": {"$ref": "#/$defs/value"},
        "human_readable_diff": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "referenced_diagnoses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "precision_recall_imbalance",
              "training_plateau",
              "suspected_overfitting",
              "post_peak_degradation"
            ]
          },
          "uniqueItems": true
        },
        "expected_effects": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "estimated_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "training_required", "description"],
          "properties": {
            "level": {"enum": ["low", "medium", "high"]},
            "training_required": {"type": "boolean"},
            "description": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
